# ---------------------------------------------------------------------------
# CN_project environment template
# Copy to `.env` (project root or backend/) and replace the secret.
# Never commit the real `.env`.
# ---------------------------------------------------------------------------

APP_NAME="Dark Web Threat Actor De-anonymization and Intelligence Platform"
ENVIRONMENT=development

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-use-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Relative SQLite paths resolve against the backend directory.
DATABASE_URL=sqlite:///./data/app.db

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

MODEL_DIR=./models
SYNTHETIC_DATA_DIR=./data/synthetic
MAX_UPLOAD_BYTES=5000000

# Analysis thresholds
MIN_STYLE_WORDS=20
MIN_BEHAVIOUR_EVENTS=3
INFERENCE_THRESHOLD=0.6

# Scoring weights (should sum to 1.0)
WEIGHT_IDENTIFIER=0.35
WEIGHT_STYLOMETRIC=0.2
WEIGHT_BEHAVIOURAL=0.2
WEIGHT_TEMPORAL=0.15
WEIGHT_INFRASTRUCTURE=0.1

# External intelligence feeds (documented public interfaces)
APTNOTES_URL=https://raw.githubusercontent.com/aptnotes/data/master/APTnotes.json
URLHAUS_RECENT_URL=https://urlhaus-api.abuse.ch/v1/urls/recent/
THREATFOX_URL=https://threatfox-api.abuse.ch/api/v1/
MITRE_ATTACK_URL=https://raw.githubusercontent.com/mitre-attack/attack-stix-data/master/enterprise-attack/enterprise-attack.json

# Optional: ThreatFox requires a free abuse.ch Auth-Key. Leave empty to disable.
ABUSE_CH_AUTH_KEY=
FEED_TIMEOUT_SECONDS=30
FEED_MAX_RETRIES=2
